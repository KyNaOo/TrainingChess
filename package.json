{
  "name": "opening-trainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm content:build && next dev",
    "build": "pnpm content:build && next build",
    "content:build": "tsx scripts/build-content.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "serve:out": "serve out --listen 3000 --no-request-logging"
  },
  "dependencies": {
    "chessops": "^0.15.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "serve": "^14.2.8",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@12.21.0",
  "description": "Apprendre une ouverture d'échecs en une session.",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  }
}
